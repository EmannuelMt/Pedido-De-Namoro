{
  "entities": {
    "CustomTheme": {
      "title": "Custom Theme",
      "description": "Customized theme configuration created in the sandbox",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "colors": { "type": "object" },
        "layout": { "type": "string" },
        "animationsEnabled": { "type": "boolean" },
        "activeEffects": { "type": "array" },
        "fontFamily": { "type": "string" },
        "backgroundImage": { "type": "string" },
        "soundUrl": { "type": "string" },
        "premium": { "type": "boolean" },
        "isCustom": { "type": "boolean" },
        "createdAt": { "type": "string" }
      }
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile with avatar and banner images",
      "type": "object",
      "properties": {
        "avatar": { "type": "string", "description": "Base64 encoded avatar image" },
        "banner": { "type": "string", "description": "Base64 encoded banner image" }
      }
    },
    "Setting": {
      "title": "Setting",
      "description": "Dynamic configuration settings for theme, colors, appearance, wallpapers, and saved presets",
      "type": "object",
      "properties": {
        "theme": { "type": "string" },
        "customPrimary": { "type": "string" },
        "customSecondary": { "type": "string" },
        "customAccent": { "type": "string" },
        "customBg": { "type": "string" },
        "customText": { "type": "string" },
        "mode": { "type": "string" },
        "fontFamily": { "type": "string" },
        "fontSize": { "type": "string" },
        "layoutStyle": { "type": "string" },
        "componentConfig": { "type": "object" },
        "visualEffects": { "type": "object" },
        "animationSettings": { "type": "object" },
        "accessibility": { "type": "object" },
        "themes": { "type": "array" },
        "globalWallpaper": { "type": "object" },
        "pageWallpapers": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    },
    "Story": {
      "title": "Story",
      "description": "Timeline/milestone events shared by the couple",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "icon": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["title", "date", "description", "location", "icon"]
    },
    "Album": {
      "title": "Album",
      "description": "Photo album categories created by the couple",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "coverUrl": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["title", "date", "category"]
    },
    "Photo": {
      "title": "Photo",
      "description": "Images uploaded inside albums",
      "type": "object",
      "properties": {
        "albumId": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["title", "category", "imageUrl"]
    },
    "GameScore": {
      "title": "Game Score",
      "description": "Scores achieved by users on different games",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "gameId": { "type": "string" },
        "score": { "type": "number" },
        "createdAt": { "type": "object" }
      },
      "required": ["userId", "gameId", "score"]
    },
    "UserAchievement": {
      "title": "User Achievement",
      "description": "Achievements unlocked by users",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "achievementId": { "type": "string" },
        "unlockedAt": { "type": "object" }
      },
      "required": ["userId", "achievementId"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notifications representing game events, rewards, social, store and achievements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "category": { "type": "string" },
        "icon": { "type": "string" },
        "url": { "type": "string" },
        "readed": { "type": "boolean" },
        "createdAt": { "type": "object" }
      },
      "required": ["userId", "title", "message", "type", "category"]
    },
    "Song": {
      "title": "Song",
      "description": "Shared songs and dedications from the couple",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "feeling": { "type": "string" },
        "spotifyUrl": { "type": "string" },
        "spotifyTrackId": { "type": "string" },
        "addedBy": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["title", "artist", "spotifyUrl", "spotifyTrackId"]
    }
  },
  "firestore": {
    "/notifications/{notificationId}": {
      "schema": { "$ref": "Notification" },
      "description": "Real-time in-app notification center alerts and alerts queue"
    },
    "/user_profiles/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "User custom avatar and banner preferences by UID"
    },
    "/user_profiles/{userId}/custom_themes/{themeId}": {
      "schema": { "$ref": "CustomTheme" },
      "description": "User custom created themes for the theme engine"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "Setting" },
      "description": "Global customizer/appearance documents (e.g., appearance_config, saved_themes, wallpaper)"
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "Story" },
      "description": "Timeline milestones stories"
    },
    "/albums/{albumId}": {
      "schema": { "$ref": "Album" },
      "description": "Media albums references"
    },
    "/photos/{photoId}": {
      "schema": { "$ref": "Photo" },
      "description": "Media pictures references"
    },
    "/songs/{songId}": {
      "schema": { "$ref": "Song" },
      "description": "Shared musical songs and tracks"
    },
    "/game_scores/{scoreId}": {
      "schema": { "$ref": "GameScore" },
      "description": "Scores recorded in games"
    },
    "/user_achievements/{achievementId}": {
      "schema": { "$ref": "UserAchievement" },
      "description": "Records of user-unlocked game achievements"
    }
  }
}
