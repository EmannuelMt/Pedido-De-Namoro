rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hardened helper functions
    function isSignedIn() { 
      return request.auth != null && request.auth.token.email_verified == true; 
    }
    
    function isOwner(userId) { 
      return isSignedIn() && request.auth.uid == userId; 
    }

    function isValidSong(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.artist is string && data.artist.size() <= 200 &&
             data.spotifyUrl is string && data.spotifyUrl.size() <= 500 &&
             data.spotifyTrackId is string && data.spotifyTrackId.size() <= 100;
    }

    // user_profiles collections
    match /user_profiles/{userId} {
      allow read: if true; // Publicly readable so visitors see custom avatars & banners
      allow write: if isOwner(userId);

      match /custom_themes/{themeId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // settings collections
    match /settings/{settingId} {
      allow read: if true; // Dynamic theme is loaded for all public visitors
      allow write: if isSignedIn();
    }

    // stories collections
    match /stories/{storyId} {
      allow read: if true; // Anyone can read timeline stories
      allow write: if isSignedIn();
    }

    // albums collections
    match /albums/{albumId} {
      allow read: if true; // Anyone can read photo albums
      allow write: if isSignedIn();
    }

    // photos collections
    match /photos/{photoId} {
      allow read: if true; // Anyone can view uploaded photos
      allow write: if isSignedIn();
    }

    // videos collections
    match /videos/{videoId} {
      allow read: if true; // Anyone can view uploaded videos
      allow write: if isSignedIn();
    }

    // songs collections
    match /songs/{songId} {
      allow read: if true; // Publicly readable
      allow create: if isSignedIn() && isValidSong(request.resource.data);
      allow update: if isSignedIn() && isValidSong(request.resource.data);
      allow delete: if isSignedIn();
    }

    // game_scores collections
    match /game_scores/{scoreId} {
      allow read: if true; // Anyone can read rankings
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // notifications collection
    match /notifications/{notificationId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // user_achievements collections
    match /user_achievements/{achievementId} {
      allow read: if true; // Anyone can view achievements
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Global safety net: default deny (Moved to bottom)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
